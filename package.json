{
  "name": "gym-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:generate": "pnpm --filter @gym/api db:generate",
    "db:migrate": "pnpm --filter @gym/api db:migrate",
    "db:deploy": "pnpm --filter @gym/api db:deploy",
    "db:status": "pnpm --filter @gym/api db:status",
    "db:studio": "pnpm --filter @gym/api db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "2.11.1"
  }
}
