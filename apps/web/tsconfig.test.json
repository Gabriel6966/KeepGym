{
  "extends": "@gym/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/lib/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
