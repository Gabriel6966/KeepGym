generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash     String            @map("password_hash") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         Session[]
  profile          Profile?
  workoutTemplates WorkoutTemplate[]

  @@map("users")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("experience_level")
}

enum TrainingGoal {
  GENERAL_FITNESS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE

  @@map("training_goal")
}

enum UnitSystem {
  METRIC
  IMPERIAL

  @@map("unit_system")
}

model Profile {
  userId          String           @id @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String           @map("display_name") @db.VarChar(80)
  birthDate       DateTime?        @map("birth_date") @db.Date
  heightCm        Int?             @map("height_cm")
  experienceLevel ExperienceLevel? @map("experience_level")
  trainingGoal    TrainingGoal?    @map("training_goal")
  unitSystem      UnitSystem       @default(METRIC) @map("unit_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profiles")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE

  @@map("muscle_group")
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  SMITH_MACHINE
  EZ_BAR
  RESISTANCE_BAND
  OTHER

  @@map("equipment")
}

enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  ISOLATION
  CARRY
  OTHER

  @@map("movement_pattern")
}

model Exercise {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                    @db.VarChar(120)
  slug              String                    @unique(map: "exercises_slug_key") @db.VarChar(140)
  description       String?                   @db.Text
  instructions      String[]                  @default([])
  primaryMuscle     MuscleGroup               @map("primary_muscle")
  secondaryMuscles  MuscleGroup[]             @default([]) @map("secondary_muscles")
  equipment         Equipment
  movementPattern   MovementPattern           @map("movement_pattern")
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  templateExercises WorkoutTemplateExercise[]

  @@index([isActive, name, id], map: "exercises_active_name_id_idx")
  @@index([primaryMuscle, isActive], map: "exercises_muscle_active_idx")
  @@index([equipment, isActive], map: "exercises_equipment_active_idx")
  @@index([movementPattern, isActive], map: "exercises_movement_active_idx")
  @@map("exercises")
}

model WorkoutTemplate {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String                    @db.VarChar(120)
  description String?                   @db.Text
  archivedAt  DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  exercises   WorkoutTemplateExercise[]

  @@index([userId, archivedAt], map: "workout_templates_user_archived_idx")
  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutTemplateId String          @map("workout_template_id") @db.Uuid
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exerciseId        String          @map("exercise_id") @db.Uuid
  exercise          Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position          Int
  targetSets        Int             @map("target_sets")
  targetRepsMin     Int             @map("target_reps_min")
  targetRepsMax     Int             @map("target_reps_max")
  restSeconds       Int             @default(90) @map("rest_seconds")
  notes             String?         @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workoutTemplateId, position], map: "template_exercises_position_key")
  @@unique([workoutTemplateId, exerciseId], map: "template_exercises_exercise_key")
  @@index([exerciseId], map: "template_exercises_exercise_idx")
  @@map("workout_template_exercises")
}
